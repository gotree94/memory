; ============================================================
; GDDR Memory Generator for Virtuoso
; GDDR5 / GDDR6 / GDDR6X ?¥Î†à??Î∞?I/O ?åÎ°ú ?êÎèô ?ùÏÑ±
; ============================================================
; Cadence 45nm ?ôÏäµ PDK ?∞Îèô:
;   load("flow/skill/cad45_init.skill")
;   load("flow/skill/cad45_periph.skill")   ; PAD Îß§Ìïë: PADDB/PADDOZ/PADDI
;   load("gddr_generator.skill")
;   gddrCreateArray("gddr_lib" "gddr6x_array" "GDDR6X" 16 4 16)
; ============================================================
when(ignoreError(cad45LibsEnabled(nil)) != t,
    printf("gddr: WARNING - cad45_init.skill not loaded, "
        "run load(\"flow/skill/cad45_init.skill\") first\\n")
)

; ============================================================
; Í≥µÌÜµ ?¨Ìçº
; ============================================================

procedure(gddrCommon(libName cellName viewName)
    let((cv)
        when(geCreateCell(ddGetObj(libName) libName cellName viewName "layout" "layout"),
            printf("Created: %s/%s/%s\\n" libName cellName viewName))
        cv = dbOpenCellViewByType(libName cellName viewName "" "a")
        when(nil == cv,
            printf("Error: Cannot open cell view %s\\n" cellName)
            return(nil))
        return(cv)
    )
endprocedure


; ============================================================
; 1. GDDR ?Ä ?¥Î†à???ùÏÑ± (SINGLE 32-bit)
; ============================================================

procedure(gddrCreateArray(
    libName
    cellName
    generation    ; "GDDR5", "GDDR6", "GDDR6X"
    numBanks
    bankGroups
    bitsPerChannel
)
    let((cv ws tech
          chipW chipH
          channelW channelH
          bankW bankH
          bgW bgH
          i j ch bg
          dqRowX)

        ; ========================================
        ; ?∏Î?Î≥?Ïπ?/ Ï±ÑÎÑê ?åÎùºÎØ∏ÌÑ∞
        ; ========================================
        when(generation == "GDDR5",
            chipW = 14.0;  chipH = 8.0    ; mm
            channelW = 14.0; channelH = 8.0
            numCh = 1
        )
        when(generation == "GDDR6",
            chipW = 16.0;  chipH = 9.0
            channelW = 7.5; channelH = 9.0
            numCh = 2   ; Dual 16-bit ?úÎ∏åÏ±ÑÎÑê
        )
        when(generation == "GDDR6X",
            chipW = 16.0;  chipH = 9.0
            channelW = 7.5; channelH = 9.0
            numCh = 2
        )

        cv = gddrCommon(libName cellName "layout")
        when(nil == cv, return(nil))

        ; ========================================
        ; ?Ä ?¥Î†à??Î∞?Î±ÖÌÅ¨ Í∑∏Î£π ?àÏù¥?ÑÏõÉ
        ; ========================================
        printf("[%s] Generating cell array view...\\n" generation)
        printf("  Chip Size: %.1f x %.1f mm\\n" chipW chipH)
        printf("  Channels: %d\\n" numCh)
        printf("  Banks: %d, Bank Groups: %d\\n" numBanks bankGroups)

        ; Ï±ÑÎÑê ?ÅÏó≠ Î∞∞Ïπò
        for(ch 0 numCh-1,
            chX = ch * (channelW + 0.5)
            dbCreateRect(cv list("M1" "drawing")
                list(chX 0.0 (+ chX channelW) channelH))
            dbCreateText(cv sprintf(nil "Ch_%d" ch)
                list(+ chX 0.5) 0.5 "M1" 0.5 "centerCenter")

            ; Ï±ÑÎÑê ??Î±ÖÌÅ¨ Í∑∏Î£π Î∂ÑÌï†
            bgW = channelW / bankGroups
            for(bg 0 bankGroups-1,
                bgX = chX + bg * bgW
                dbCreateRect(cv list("M2" "drawing")
                    list(bgX 1.0 (+ bgX bgW) (- channelH 2.0)))
                dbCreateText(cv sprintf(nil "BG%02d" bg)
                    list(+ bgX 0.3) (+ channelH 2.5) "M2" 0.3 "centerCenter")
            )

            ; DQ ?∞Ïù¥???®Îìú
            for(i 0 bitsPerChannel-1,
                dqX = chX + 1.0 + i * 0.6
                dbCreateRect(cv list("M3" "drawing")
                    list(dqX (- 0.5) (+ dqX 0.5) 0.5))
                dbCreateText(cv sprintf(nil "DQ%02d" i)
                    list(+ dqX 0.3) 0.5 "M3" 0.2 "centerCenter")
            )
        )

        ; DQS / WCK ?¥Îü≠ ?ÅÏó≠
        dbCreateText(cv "DQS0" list(0.5 (- 1.2)) "M2" 0.3 "centerCenter")
        dbCreateText(cv "WCK0" list(2.0 (- 1.2)) "M2" 0.3 "centerCenter")
        when(generation == "GDDR6" || generation == "GDDR6X",
            dbCreateText(cv "DQS1" list(9.0 (- 1.2)) "M2" 0.3 "centerCenter")
            dbCreateText(cv "WCK1" list(10.5 (- 1.2)) "M2" 0.3 "centerCenter")
        )

        ; ========================================
        ; ?úÍ∑∏?êÎßÅ ?àÏù¥Î∏?        ; ========================================
        when(generation == "GDDR6X",
            ; PAM4 ?àÎ≤® ?úÏãú
            dbCreateText(cv "PAM4" list(0.5 (+ channelH 1.0))
                "M3" 0.4 "centerCenter")
            dbCreateText(cv "L0:L3" list(0.5 (+ channelH 1.6))
                "M3" 0.2 "centerCenter")
        )
        when(generation == "GDDR5",
            dbCreateText(cv "NRZ" list(0.5 (+ channelH 1.0))
                "M3" 0.4 "centerCenter")
        )

        dbSave(cv)
        printf("[%s] Array generation complete\\n" generation)
    )
endprocedure


; ============================================================
; 2. GDDR I/O ?∏Î†å?úÎ≤Ñ ?åÎ°ú ?ùÏÑ± (NRZ)
; ============================================================

procedure(gddrCreateIOCircuit(
    libName
    ioCellName
    generation    ; "GDDR5", "GDDR6"
)
    let((cv)

        cv = gddrCommon(libName ioCellName "schematic")
        when(nil == cv, return(nil))

        printf("[%s] Generating NRZ I/O transceiver...\\n" generation)

        ; NRZ ?âÎ¨∏??TX/RX ?§Ï?ÎßàÌã± Íµ¨Ï°∞
        ; ?Ä?Ä TX: DATA ?Ä?Ä> [Driver] ?Ä?Ä> TX_OUT
        ; ?Ä?Ä RX: RX_IN ?Ä?Ä> [Receiver] ?Ä?Ä> DATA_OUT

        ; ?§Ï?ÎßàÌã± ?ùÏÑ±?Ä ?åÎ°ú???ÄÎ°?Ï≤òÎ¶¨
        dbCreateText(cv "DATA" list(1.0 5.0) "M1" 0.3 "centerCenter")
        dbCreateText(cv "TX" list(3.0 5.0) "M1" 0.3 "centerCenter")
        dbCreateText(cv "TX_OUT" list(5.0 5.0) "M1" 0.3 "centerCenter")
        dbCreateText(cv "RX_IN" list(5.0 3.0) "M1" 0.3 "centerCenter")
        dbCreateText(cv "RX" list(3.0 3.0) "M1" 0.3 "centerCenter")
        dbCreateText(cv "DOUT" list(1.0 3.0) "M1" 0.3 "centerCenter")

        dbSave(cv)
        printf("[%s] NRZ I/O circuit generated\\n" generation)
    )
endprocedure


; ============================================================
; 3. PAM4 ?∏Î†å?úÎ≤Ñ ?åÎ°ú ?ùÏÑ± (GDDR6X)
; ============================================================

procedure(gddrCreatePAM4IO(
    libName
    ioCellName
)
    let((cv)

        cv = gddrCommon(libName ioCellName "schematic")
        when(nil == cv, return(nil))

        printf("[GDDR6X] Generating PAM4 I/O transceiver...\\n")

        ; PAM4 4-?àÎ≤® ?†Ìò∏ ?ùÏÑ±
        ; MSB/LSB ??TX ??PAM4 Ï∂úÎ†•
        ; RX ???¨Îùº?¥ÏÑú ??MSB/LSB Î≥µÏõê

        ; TX Î∏îÎ°ù
        dbCreateInst(cv "pam4_encoder" "PAM4_ENC" list(2.0 5.0) "R0")
        dbCreateInst(cv "tx_pad" "TX_PAD" list(4.0 5.0) "R0")

        ; RX Î∏îÎ°ù (3Í∞??¨Îùº?¥ÏÑú: VREF1/2/3 ÎπÑÍµê)
        dbCreateInst(cv "rx_pad" "RX_PAD" list(4.0 3.0) "R0")
        dbCreateInst(cv "slicer1" "SL1" list(3.0 2.0) "R0")
        dbCreateInst(cv "slicer2" "SL2" list(3.0 1.5) "R0")
        dbCreateInst(cv "slicer3" "SL3" list(3.0 1.0) "R0")
        dbCreateInst(cv "decoder" "PAM4_DEC" list(2.0 2.0) "R0")

        ; ?àÎ≤® ?∏Í∑∏Î®ºÌä∏
        dbCreateText(cv "MSB" list(1.0 6.0) "M1" 0.2 "centerCenter")
        dbCreateText(cv "LSB" list(1.0 5.5) "M1" 0.2 "centerCenter")
        dbCreateText(cv "PAM4_TX" list(5.0 5.0) "M2" 0.2 "centerCenter")
        dbCreateText(cv "PAM4_RX" list(5.0 3.0) "M2" 0.2 "centerCenter")

        ; ?àÌçº?∞Ïä§ ?ÑÏïï
        dbCreateText(cv "VREF1" list(5.5 2.2) "M3" 0.1 "centerCenter")
        dbCreateText(cv "VREF2" list(5.5 1.7) "M3" 0.1 "centerCenter")
        dbCreateText(cv "VREF3" list(5.5 1.2) "M3" 0.1 "centerCenter")

        dbSave(cv)
        printf("[GDDR6X] PAM4 I/O circuit generated\\n")
    )
endprocedure


; ============================================================
; 4. GDDR ?Ä??Ï±ÑÎÑê Î∂ÑÎ¶¨ (GDDR6/GDDR6X)
; ============================================================

procedure(gddrCreateDualChannel(
    libName
    cellName
    bitsPerChannel   ; 16
)
    let((cv i)

        cv = gddrCommon(libName cellName "layout")
        when(nil == cv, return(nil))

        printf("Generating dual independent channel (2x%d-bit)...\\n" bitsPerChannel)

        ; Channel A (Ï¢åÏ∏°) / Channel B (?∞Ï∏°) Î∂ÑÎ¶¨
        ; Í∞?Ï±ÑÎÑê???ÖÎ¶Ω??Ïª§Îß®???¥Îìú?àÏä§/?∞Ïù¥??Î≤ÑÏä§
        for(i 0 1,
            chX = i * 8.0   ; Ï±ÑÎÑê Í∞?Î¨ºÎ¶¨??0.5mm Í∞ÑÍ≤© ?¨Ìï®

            dbCreateRect(cv list("M1" "drawing")
                list(chX 0.0 (+ chX 7.5) 9.0))
            dbCreateText(cv sprintf(nil "CH%c" (+ 65 i))
                list(+ chX 0.5) 8.0 "M1" 0.4 "centerCenter")

            ; ?ÖÎ¶Ω DQ 16-bit
            for(j 0 bitsPerChannel-1,
                dqX = chX + 1.0 + j * 0.4
                dbCreateText(cv sprintf(nil "%c_DQ%02d" (+ 65 i) j)
                    list(dqX (- 0.5)) "M2" 0.15 "centerCenter")
            )

            ; ?ÖÎ¶Ω Ïª§Îß®???¥Îìú?àÏä§
            dbCreateText(cv sprintf(nil "%c_CMD" (+ 65 i))
                list(+ chX 0.5) 1.0 "M2" 0.2 "centerCenter")
            dbCreateText(cv sprintf(nil "%c_ADDR" (+ 65 i))
                list(+ chX 0.5) 1.5 "M2" 0.2 "centerCenter")
        )

        ; Ï±ÑÎÑê Î∂ÑÎ¶¨ Î≤?(?ÑÏù¥?îÎ†à?¥ÏÖò)
        dbCreatePath(cv list(7.75 0.0 7.75 9.0) "M4" 0.1)

        dbSave(cv)
        printf("Dual channel layout generated\\n")
    )
endprocedure


; ============================================================
; 5. ?¥Îü≠ ?∏Î¶¨ ?ùÏÑ± (WCK/CK)
; ============================================================

procedure(gddrCreateClockTree(
    libName
    cellName
    numPLL
    numWCK
)
    let((cv i)

        cv = gddrCommon(libName cellName "layout")
        when(nil == cv, return(nil))

        printf("Generating WCK/CK clock distribution...\\n")

        ; PLL Î∞∞Ïπò
        for(i 0 numPLL-1,
            dbCreateRect(cv list("M1" "drawing")
                list((* i 4.0) 2.0 (+ (* i 4.0) 3.0) 5.0))
            dbCreateText(cv sprintf(nil "PLL%02d" i)
                list((* i 4.0) 1.0) "M2" 0.3 "centerCenter")
        )

        ; WCK Ï∞®Îèô ?¥Îü≠ Î≤ÑÌçº
        for(i 0 numWCK-1,
            wckX = i * 2.5
            dbCreateText(cv sprintf(nil "WCK%d/WCK#%d" i i)
                list(wckX 7.0) "M3" 0.2 "centerCenter")
        )

        dbSave(cv)
        printf("Clock tree generated\\n")
    )
endprocedure


