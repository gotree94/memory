; ============================================================
; 6T SRAM Cell Layout Generator for Virtuoso
; 6T SRAM ?Ä ?àÏù¥?ÑÏõÉ ?êÎèô ?ùÏÑ± ?§ÌÅ¨Î¶ΩÌä∏
; ============================================================
; Usage: Virtuoso CIW?êÏÑú ?¨Ïö©
;   load("flow/skill/cad45_init.skill")      ; (Í∂åÏû•) GPDK045/gsclib045 Î°úÎìú
;   load("sram_6t_generator.skill")
;   sram6TGenerate("sram_lib" "my_6t_cell" "45nm")
; ============================================================
; Cadence 45nm ?ôÏäµ PDK (GPDK045/giolib045 + gsclib045) ?∞Îèô
;   "45nm" Í∏∞Ïà† ?∏Îìú??GPDK045 ?îÎ∞î?¥Ïä§(g45n1svt/g45p1svt) Í∏∞Ï? ?åÎùºÎØ∏ÌÑ∞.
when(ignoreError(cad45LibsEnabled(nil)) != t,
    ; ?ºÏù¥Î∏åÎü¨Î¶?Î°úÎìúÍ∞Ä ???òÎäî Í≤ΩÏö∞?êÎèÑ ?∞Î™® ?§Ìñâ?Ä Í∞Ä?•ÌïòÍ≤?Í≤ΩÍ≥†Îß?Ï∂úÎ†•
    printf("sram6T: WARNING - cad45_init.skill not loaded, "
        "run load(\"flow/skill/cad45_init.skill\") first\\n")
)

procedure(sram6TGenerate(
    libName      ; ?ºÏù¥Î∏åÎü¨Î¶??¥Î¶Ñ
    cellName     ; ?Ä ?¥Î¶Ñ
    techNode     ; Í∏∞Ïà† ?∏Îìú ("14nm", "65nm", "350nm", "1um", "5um")
)
    let((cv ws tech cellBox
          puW pdW pgW           ; ?∏ÎûúÏßÄ?§ÌÑ∞ ??          cellH cellW           ; ?Ä ?îÎ©ò??          vddH vssH wlH         ; Î∞∞ÏÑ† ?íÏù¥
          ptapW ntapW           ; tap ?ÅÏó≠
          m1Width m2Width m3Width ; Î©îÌÉà ??          polyWidth            ; ?¥Î¶¨ ??          ))

        ; ========================================
        ; Í∏∞Ïà† ?∏ÎìúÎ≥??åÎùºÎØ∏ÌÑ∞ ?§Ï†ï
        ; ========================================
        when(techNode == "5um",
            puW = 10.0;    pdW = 10.0;    pgW = 5.0
            cellH = 40.0;  cellW = 20.0   ; Œºm
            m1Width = 2.0; m2Width = 2.0; m3Width = 2.0
            polyWidth = 2.0
            vddH = 4.0;    vssH = 4.0;    wlH = 2.0
        )
        when(techNode == "1um",
            puW = 2.0;     pdW = 2.0;     pgW = 1.5
            cellH = 8.0;   cellW = 4.0
            m1Width = 0.6; m2Width = 0.6; m3Width = 0.6
            polyWidth = 0.5
            vddH = 1.0;    vssH = 1.0;    wlH = 0.5
        )
        when(techNode == "350nm",
            puW = 0.7;     pdW = 0.7;     pgW = 0.5
            cellH = 1.4;   cellW = 0.8
            m1Width = 0.2; m2Width = 0.2; m3Width = 0.2
            polyWidth = 0.18
            vddH = 0.35;   vssH = 0.35;   wlH = 0.2
        )
        when(techNode == "45nm",
            ; ===== GPDK045 (Cadence 45nm ?ôÏäµ PDK) Í∏∞Ï? =====
            ; g45p1svt (PU), g45n1svt (PD), g45n1svt (PG)
            puW = 0.09;    pdW = 0.14;    pgW = 0.09
            cellH = 0.27;  cellW = 0.11
            m1Width = 0.05; m2Width = 0.05; m3Width = 0.05
            polyWidth = 0.045
            vddH = 0.05;   vssH = 0.05;   wlH = 0.05
        )
        when(techNode == "65nm",
            puW = 0.21;    pdW = 0.14;    pgW = 0.105
            cellH = 0.36;  cellW = 0.14
            m1Width = 0.07; m2Width = 0.07; m3Width = 0.07
            polyWidth = 0.065
            vddH = 0.07;   vssH = 0.07;   wlH = 0.07
        )
        when(techNode == "14nm",
            puW = 0.042;   pdW = 0.028;   pgW = 0.021
            cellH = 0.072; cellW = 0.030
            m1Width = 0.024; m2Width = 0.024; m3Width = 0.024
            polyWidth = 0.014
            vddH = 0.024;  vssH = 0.024;  wlH = 0.024
        )

        ; ========================================
        ; ?Ä Î∑??ùÏÑ±
        ; ========================================
        when(geCreateCell(ddGetObj(libName) libName cellName "layout" "layout"),
            printf("Created: %s/%s/layout\\n" libName cellName)
        )

        cv = dbOpenCellViewByType(libName cellName "layout" "" "a")
        when(nil == cv,
            printf("Error: Cannot open cell view\\n")
            return(nil)
        )

        ; Í∏∞Ïà† ?ºÏù¥Î∏åÎü¨Î¶?Î°úÎìú (?†ÌÉù?¨Ìï≠)
        when(techExists(libName),
            tech = techOpen(libName)
        )

        ; ========================================
        ; ?àÏù¥?ÑÏõÉ ?ùÏÑ±
        ; ========================================

        ; --- N-Well (PMOS ?ÅÏó≠) ---
        ; ?Ä ?ÅÎã® 1/3 ?ÅÏó≠
        dbCreateRect(cv list("NWell" "drawing")
            list(0.0 (* cellH 0.66) cellW cellH))

        ; --- P-Well / Substrate (NMOS ?ÅÏó≠) ---
        ; ?Ä ?òÎã® 2/3 ?ÅÏó≠ (Í∏∞Î≥∏ Í∏∞Ìåê)

        ; --- Active Area ---
        ; PMOS Active (?ÅÎã®)
        dbCreateRect(cv list("Active" "drawing")
            list((* pgW 0.5) (* cellH 0.7)
                 (- cellW (* pgW 0.5)) (* cellH 0.9)))

        ; NMOS Active (?òÎã®) - 2Í∞??ÅÏó≠
        ; Left NMOS (PD, PG)
        dbCreateRect(cv list("Active" "drawing")
            list((* pgW 0.5) (* cellH 0.1)
                 (- cellW (* pgW 0.5)) (* cellH 0.3)))
        ; Right NMOS (PD, PG)
        dbCreateRect(cv list("Active" "drawing")
            list((* pgW 0.5) (* cellH 0.4)
                 (- cellW (* pgW 0.5)) (* cellH 0.6)))

        ; --- Poly Gate ---
        ; Wordline (WL) - ?òÌèâ ?¥Î¶¨
        dbCreateRect(cv list("Poly" "drawing")
            list(0.0 (* cellH 0.5) cellW (+ (* cellH 0.5) polyWidth)))

        ; ?òÏßÅ ?¥Î¶¨ (Í∞??∏ÎûúÏßÄ?§ÌÑ∞)
        ; Left PU PMOS
        dbCreateRect(cv list("Poly" "drawing")
            list((* cellW 0.3) (* cellH 0.6)
                 (+ (* cellW 0.3) polyWidth) (* cellH 1.0)))
        ; Right PU PMOS
        dbCreateRect(cv list("Poly" "drawing")
            list((* cellW 0.7) (* cellH 0.6)
                 (+ (* cellW 0.7) polyWidth) (* cellH 1.0)))
        ; Left PD/PG NMOS
        dbCreateRect(cv list("Poly" "drawing")
            list((* cellW 0.3) 0.0
                 (+ (* cellW 0.3) polyWidth) (* cellH 0.4)))
        ; Right PD/PG NMOS
        dbCreateRect(cv list("Poly" "drawing")
            list((* cellW 0.7) 0.0
                 (+ (* cellW 0.7) polyWidth) (* cellH 0.4)))

        ; --- Metal 1: VDD Rail ---
        dbCreateRect(cv list("M1" "drawing")
            list(0.0 (- cellH 0.05) cellW cellH))

        ; --- Metal 1: VSS Rail ---
        dbCreateRect(cv list("M1" "drawing")
            list(0.0 0.0 cellW 0.05))

        ; --- Metal 2: Q, Q_bar (?¥Î? ?∏Îìú) ---
        ; Q (Ï¢åÏ∏° ?¥Î?)
        dbCreateRect(cv list("M2" "drawing")
            list((* cellW 0.2) (* cellH 0.35)
                 (* cellW 0.4) (* cellH 0.65)))
        ; Q_bar (?∞Ï∏° ?¥Î?)
        dbCreateRect(cv list("M2" "drawing")
            list((* cellW 0.6) (* cellH 0.35)
                 (* cellW 0.8) (* cellH 0.65)))

        ; --- Metal 3: Bitline (BL, BLB) ---
        ; BL (Ï¢åÏ∏° ?òÏßÅ)
        dbCreatePath(cv list((* cellW 0.1) 0.0 (* cellW 0.1) cellH)
            "M3" m3Width)
        ; BLB (?∞Ï∏° ?òÏßÅ)
        dbCreatePath(cv list((* cellW 0.9) 0.0 (* cellW 0.9) cellH)
            "M3" m3Width)

        ; --- Via ?∞Í≤∞ ---
        ; VDD to M1-M2 via
        dbCreateVia(cv "M1_M2" (* cellW 0.5) (- cellH 0.02) "R0")
        ; VSS to M1-M2 via
        dbCreateVia(cv "M1_M2" (* cellW 0.5) 0.02 "R0")
        ; BL to M2-M3 via
        dbCreateVia(cv "M2_M3" (* cellW 0.1) (* cellH 0.5) "R0")
        ; BLB to M2-M3 via
        dbCreateVia(cv "M2_M3" (* cellW 0.9) (* cellH 0.5) "R0")

        ; --- Text Labels ---
        dbCreateText(cv "VDD" list((* cellW 0.5) (+ cellH 0.1))
            "M1" 0.1 "centerCenter")
        dbCreateText(cv "VSS" list((* cellW 0.5) (- 0.0 0.1))
            "M1" 0.1 "centerCenter")
        dbCreateText(cv "WL" list((- 0.0 0.1) (* cellH 0.5))
            "Poly" 0.08 "centerCenter")
        dbCreateText(cv "BL" list((* cellW 0.1) (- 0.0 0.1))
            "M3" 0.08 "centerCenter")
        dbCreateText(cv "BLB" list((* cellW 0.9) (- 0.0 0.1))
            "M3" 0.08 "centerCenter")
        dbCreateText(cv "Q" list((* cellW 0.3) (* cellH 0.5))
            "M2" 0.06 "centerCenter")
        dbCreateText(cv "Q_bar" list((* cellW 0.7) (* cellH 0.5))
            "M2" 0.06 "centerCenter")

        ; ========================================
        ; ?àÏù¥?ÑÏõÉ ?Ä??        ; ========================================
        dbSave(cv)
        printf("6T SRAM cell generated successfully: %s\\n" cellName)
        printf("  Cell Size: %.2f x %.2f um\\n" cellW cellH)
        printf("  Area: %.4f um^2\\n" (* cellW cellH))
    )
endprocedure


; ============================================================
; 6T SRAM ?Ä ?åÎ†à?¥Ïä§ & ?ºÏö∞??; ============================================================

procedure(sram6TPlaceAndRoute(
    libName
    cellName
    numRows     ; ?åÎìú ??    numCols     ; ÎπÑÌä∏ ??)
    let((cv cvArray cellW cellH
          i j x y instName
          wlY blX))

        ; ?êÎ≥∏ ?Ä ?¥Í∏∞
        cv = dbOpenCellViewByType(libName cellName "layout" "" "a")
        when(nil == cv,
            printf("Error: Source cell not found\\n")
            return(nil)
        )

        ; ?Ä ?îÎ©ò??Ï∂îÏ∂ú
        cellW = 0.14  ; 65nm Í∏∞Ï? (um)
        cellH = 0.36

        ; ?¥Î†à???Ä Î∑??ùÏÑ±
        arrayName = sprintf(nil "%s_%dx%d" cellName numRows numCols)
        when(geCreateCell(ddGetObj(libName) libName arrayName "layout" "layout"),
            cvArray = dbOpenCellViewByType(libName arrayName "layout" "" "a")
        )

        ; ========================================
        ; ?Ä Î∞∞Ïπò (Place)
        ; ========================================
        for(row 0 numRows-1,
            for(col 0 numCols-1,
                x = col * cellW
                y = row * cellH
                instName = sprintf(nil "SRAM_%02d_%02d" row col)
                dbCreateInst(cvArray cv cellName instName x y "R0")
            )
        )

        ; ========================================
        ; Î©îÌÉà Î∞∞ÏÑ† (Route)
        ; ========================================

        ; Wordline (WL) - ?òÌèâ Î∞∞ÏÑ† (Metal 2)
        for(row 0 numRows-1,
            wlY = row * cellH + (cellH * 0.5)
            dbCreatePath(cvArray
                list((- 0.1) wlY (+ (* numCols cellW) 0.1) wlY)
                "M2" 0.07
                list((- 0.1) (- wlY 0.05) (+ (* numCols cellW) 0.1) (+ wlY 0.05)))

            ; WL ?ºÎ≤®
            dbCreateText(cvArray
                sprintf(nil "WL_%02d" row)
                list((- 0.2) wlY)
                "M2" 0.05 "centerRight")
        )

        ; Bitline (BL/BLB) - ?òÏßÅ Î∞∞ÏÑ† (Metal 3)
        for(col 0 numCols-1,
            blX = col * cellW + (cellW * 0.1)
            blbX = col * cellW + (cellW * 0.9)

            ; BL
            dbCreatePath(cvArray
                list(blX (- 0.1) blX (+ (* numRows cellH) 0.1))
                "M3" 0.05
                list((- blX 0.03) (- 0.1) (+ blX 0.03) (+ (* numRows cellH) 0.1)))

            ; BLB
            dbCreatePath(cvArray
                list(blbX (- 0.1) blbX (+ (* numRows cellH) 0.1))
                "M3" 0.05
                list((- blbX 0.03) (- 0.1) (+ blbX 0.03) (+ (* numRows cellH) 0.1)))

            ; Bitline ?ºÎ≤®
            when(col == 0,
                dbCreateText(cvArray "BL"
                    list(blX (- 0.2)) "M3" 0.04 "centerCenter")
                dbCreateText(cvArray "BLB"
                    list(blbX (- 0.2)) "M3" 0.04 "centerCenter")
            )
        )

        ; VDD Rail - ?òÌèâ (Metal 1, ?Ä ?ÅÎã®)
        for(row 0 numRows-1,
            dbCreatePath(cvArray
                list((- 0.1) (+ (* row cellH) cellH)
                     (+ (* numCols cellW) 0.1) (+ (* row cellH) cellH))
                "M1" 0.08
                list(0 0 (+ (* numCols cellW) 0.2) (* numRows cellH)))
        )

        ; VSS Rail - ?òÌèâ (Metal 1, ?Ä ?òÎã®)
        for(row 0 numRows-1,
            dbCreatePath(cvArray
                list((- 0.1) (* row cellH)
                     (+ (* numCols cellW) 0.1) (* row cellH))
                "M1" 0.08
                list(0 0 (+ (* numCols cellW) 0.2) (* numRows cellH)))
        )

        ; VDD/VSS ?ºÎ≤®
        dbCreateText(cvArray "VDD"
            list((- 0.3) (* numRows cellH))
            "M1" 0.06 "centerRight")
        dbCreateText(cvArray "VSS"
            list((- 0.3) 0.0)
            "M1" 0.06 "centerRight")

        ; ========================================
        ; Í≤∞Í≥º ?Ä??        ; ========================================
        dbSave(cvArray)
        printf("SRAM Array generated: %s (%dx%d)\\n" arrayName numRows numCols)
        printf("  Total Area: %.4f x %.4f um\\n"
            (* numCols cellW) (* numRows cellH))
    )
endprocedure


; ============================================================
; Î©îÏù∏ ?§Ìñâ ?àÏ†ú
; ============================================================
; Virtuoso CIW?êÏÑú ?§Ìñâ:
;
; 1. ?®Ïùº ?Ä ?ùÏÑ±:
;    sram6TGenerate("my_sram_lib" "my_6t_cell_65nm" "65nm")
;
; 2. ?¥Î†à???ùÏÑ±:
;    sram6TPlaceAndRoute("my_sram_lib" "my_6t_cell_65nm" 64 8)
;
; 3. Î∞∞Ïπò ??DRC ?§Ìñâ:
;    techRunDRC(cv nil nil)
;

println("6T SRAM Generator loaded successfully")
println("Usage:")
println("  sram6TGenerate(libName cellName techNode)")
println("  sram6TPlaceAndRoute(libName cellName numRows numCols)")

